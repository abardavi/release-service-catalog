uuid=${uuid:-"$(openssl rand -hex 4)"}
# make sure uuid is 8 chars long
uuid="${uuid:0:8}"

export originating_tool="push-to-cspv2-e2e-test"

# Namespaces
# TODO: revert to dev-release-team-tenant / managed-release-team-tenant before opening the PR;
# these are temporarily set to match the local kind cluster's actual namespaces for local testing.
export tenant_namespace=default-tenant
#
## Since this is a test that requires internal services,
## this name should not change.
#
export managed_namespace=managed-tenant

export application_name=push-to-cspv2-app-${uuid}
export component_type=push-to-cspv2
export component_name=${component_type}-${uuid}
export component_branch=${component_name}
## do not change this. it is a known branch created by Konflux
export appstudio_component_branch="appstudio-${component_name}"

export component_github_org=hacbs-release-tests
# TODO: revert to push-to-cspv2-base once that branch exists in e2e-base; temporarily
# reusing push-rpms-to-pulp-base for local testing since push-to-cspv2 doesn't act on
# the snapshot's artifacts anyway.
export component_base_branch=push-rpms-to-pulp-base
export component_repo_name=${component_github_org}/${component_name}
export component_base_repo_name=${component_github_org}/e2e-base
export component_git_url=https://github.com/${component_repo_name}

export PTSV_COMPONENTS="component"

export tenant_sa_name=push-to-cspv2-sa-${uuid}
export release_plan_name=push-to-cspv2-rp-${uuid}

export managed_sa_name=push-to-cspv2-sa-${uuid}
export release_plan_admission_name=push-to-cspv2-rpa-${uuid}
